# Copy to .env and fill in. NEVER commit the real .env.
# MongoDB Atlas connection string. Database name in the path should be phoenix-official.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/phoenix-official?retryWrites=true&w=majority
# Long random secret used to sign JWT session tokens.
JWT_SECRET=change-me-to-a-long-random-string
# Google OAuth client IDs allowed as audience for native sign-in ID tokens.
# Web client ID plus the Android client ID, comma separated.
GOOGLE_CLIENT_IDS=
# Port for local dev (Render sets PORT itself).
PORT=4000
# Comma separated allowed CORS origins. Leave empty for the game client (no browser CORS needed).
CORS_ORIGINS=
