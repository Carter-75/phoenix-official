# Phoenix backend environment. Copy to .env (dev) or set in the Render
# dashboard (production). NEVER commit real values, and never paste secrets
# into chat: enter them in the host dashboard yourself.

# MongoDB connection string (database name of your choice, e.g. phoenix-official)
MONGODB_URI=

# JWT signing secret, at least 16 random characters. REQUIRED in production.
SESSION_SECRET=

# Google sign-in (client IDs are public; the web client secret is not)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated ID-token audiences for native Google sign-in (optional;
# defaults to the client IDs in capacitor.config.ts)
GOOGLE_CLIENT_IDS=

# Public URL of the web frontend, used for Google web-flow redirects
FRONTEND_URL=http://localhost:4200

# Google Play receipt verification (billing). Service account JSON with the
# androidpublisher scope, created in Google Cloud and granted access in Play
# Console. Paste the whole JSON as one line in the host dashboard only.
GOOGLE_PLAY_PACKAGE_NAME=com.phoenix.fall
GOOGLE_SERVICE_ACCOUNT_JSON=

# Web push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@phoenixwebsites.ai

PRODUCTION=false
